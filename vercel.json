{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/arcade/:action", "destination": "/api/arcade?action=:action" },
    { "source": "/api/leaderboard", "destination": "/api/leaderboard" },
    { "source": "/api/games", "destination": "/api/games" },
    { "source": "/api/og", "destination": "/api/og" },
    { "source": "/arcade", "destination": "/arcade/index.html" },
    { "source": "/arcade/court-vision", "destination": "/arcade/index.html" },
    { "source": "/arcade/fifth-run", "destination": "/arcade/index.html" },
    { "source": "/arcade/fifth-glide", "destination": "/arcade/index.html" },
    { "source": "/arcade/challenge/:id", "destination": "/api/challenge-page?id=:id" },
    { "source": "/arcade/claim", "destination": "/arcade/index.html" },
    { "source": "/arcade/key", "destination": "/arcade/index.html" },
    { "source": "/arcade/admin", "destination": "/arcade/index.html" }
  ],
  "headers": [
    {
      "source": "/arcade/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/arcade/" }
      ]
    },
    {
      "source": "/arcade/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/arcade/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [{ "path": "/api/arcade/contest-tick", "schedule": "0 13 * * *" }]
}
