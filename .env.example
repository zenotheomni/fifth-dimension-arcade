# Server (Vercel serverless /api) — publishable anon key only
SUPABASE_URL=https://czqkpxxbqleoiicumneu.supabase.co
SUPABASE_ANON_KEY=

# Browser (optional direct reads)
VITE_SUPABASE_URL=https://czqkpxxbqleoiicumneu.supabase.co
VITE_SUPABASE_ANON_KEY=

# Challenge deep-link base (no trailing slash).
# Temporary: vercel.app host until 5dimperial.com/arcade is proxied.
# Switch back to https://5dimperial.com/arcade via env only — no code change.
ARCADE_PUBLIC_BASE_URL=https://fifth-dimension-arcade.vercel.app/arcade
VITE_ARCADE_PUBLIC_BASE_URL=https://fifth-dimension-arcade.vercel.app/arcade

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://fifth-dimension-arcade.vercel.app/arcade
# Server-only key for arcade_push_dequeue/report (sha256 stored in arcade_server_keys)
ARCADE_PUSH_SERVER_KEY=
# ARCADE_PUSH_DRY_RUN=1
